# =====================================================================
# WinTokenMon — Developer Environment Overrides (Optional)
# =====================================================================
# Copy this file to `.env` in the project root to enable local overrides.
# NOTE: End-users running the compiled application do NOT need this file.

# Set to 1 to enable verbose debug logging in terminal/console
WINTOKENMON_DEBUG=0

# Polling interval in seconds (default: 10)
WINTOKENMON_POLL_INTERVAL=10

# Optional: Inject mock token consumption delta per poll for UI/animation testing
# WINTOKENMON_MOCK_DELTA=50000
